# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your values.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# Which provider to use. Currently implemented: "gemini".
# Swapping provider = change this + the matching API key (no code changes).
PROVIDER=gemini

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Model id. gemini-2.5-flash-lite is the cheapest with strong Arabic + vision.
MODEL=gemini-2.5-flash-lite

# --- Paths ------------------------------------------------------------------
# Folder to scan for input PDFs/DOCX (recursively).
INPUT_DIR=input
# Folder where anonymized .docx files are written (mirrors input structure).
OUTPUT_DIR=output
# Resume checkpoint file (tracks which PDFs are already done).
STATE_FILE=.anonymizer_state.json

# --- Processing -------------------------------------------------------------
# Pages per LLM call. Big PDFs are split into batches of this size so each
# response stays under the model's output-token limit. 3-8 is a good range.
PAGES_PER_BATCH=5
# Parallel documents processed at once (API calls are I/O-bound).
MAX_WORKERS=4
# String that replaces every detected PII value.
REPLACEMENT_TOKEN=XXXXXXX

# --- Cost reporting (USD per 1M tokens) -------------------------------------
# Used only to print an estimated cost from real token usage. Update if prices change.
INPUT_PRICE_PER_M=0.10
OUTPUT_PRICE_PER_M=0.40

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
