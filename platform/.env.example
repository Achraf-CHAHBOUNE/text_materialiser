# Project 2 — Web platform (backend + frontend + file storage + Postgres).
# Copy to ".env" in THIS folder (used by docker-compose). Never commit the real .env.

# --- File storage: holds ONLY anonymized files, never raw documents ---
# Required, with no default: anyone holding these keys can read every ruling.
# Both must be at least 8 characters (MinIO refuses to start otherwise).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Left as-is, files go to the MinIO service in docker-compose.yml.
# For AWS S3 or Google Cloud Storage, set these instead and delete that service:
#   S3_ENDPOINT=s3.amazonaws.com          # AWS
#   S3_ENDPOINT=storage.googleapis.com    # Google Cloud Storage (keys = HMAC keys)
#   S3_BUCKET=our-anonymized-rulings
#   S3_REGION=eu-west-3                   # the bucket's region
#   S3_SECURE=true
#   S3_CREATE_BUCKET=false                # create the bucket yourself, once

# --- PostgreSQL ---
POSTGRES_USER=anon
POSTGRES_PASSWORD=anon
POSTGRES_DB=anonymize

# --- Auth ---
AUTH_SECRET=change-me-in-production
# Seed an admin account on first boot (Integration + Clients):
SEED_EMAIL=admin@example.com
SEED_PASSWORD=change-me
# Optionally seed a demo client (browse/search/view):
SEED_CLIENT_EMAIL=
SEED_CLIENT_PASSWORD=

# --- Frontend (inlined at build time; browser reaches the API here) ---
VITE_API_URL=http://localhost:8000
