# platform/.env — every setting the platform reads.
#
# Copy this file to .env and fill in what you need. Nothing here is required to start:
# every field has a working default for local development, and the ones that must be
# set in production say so.
#
# The scripts read this file automatically. Inside Docker the environment comes from
# docker-compose instead, and compose always wins — a value set there is not overridden
# by this file.
#
# .env is gitignored. This example file is not: never put a real key in it.


# ─────────────────────────────────────────────────────────────────────────────
#  WHERE THE DATA LIVES
# ─────────────────────────────────────────────────────────────────────────────

# Postgres, used in production. When set, DB_DIR is ignored.
#   DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=

# SQLite, used for development: the folder holding app.db. Default: data
DB_DIR=../../data/platform

# Where the anonymized Word documents are kept. Default: data/files
# For S3 or Google Cloud Storage instead, set S3_ENDPOINT / S3_ACCESS_KEY /
# S3_SECRET_KEY / S3_BUCKET and leave this unset.
FILESTORE_DIR=../../data/platform/files


# ─────────────────────────────────────────────────────────────────────────────
#  WHO CAN SIGN IN
# ─────────────────────────────────────────────────────────────────────────────

# Signs the session tokens. Change it in production: anyone who knows it can mint a
# session for any account. Default: dev-secret-change-me
AUTH_SECRET=

# How long a session lasts, in seconds. Default: 86400 (one day)
AUTH_TTL_SECONDS=86400

# The admin account created on first start. Leave empty to create none.
SEED_EMAIL=
SEED_PASSWORD=

# A reader account, same idea. Optional.
SEED_CLIENT_EMAIL=
SEED_CLIENT_PASSWORD=

# Wrong passwords allowed before an account is locked out, and for how long.
# Defaults: 8 tries, 900 seconds. Restarting the backend clears the lockout.
LOGIN_MAX_TRIES=8
LOGIN_LOCKOUT_SECONDS=900

# Which origins the browser may call the API from. "*" is fine behind the proxy,
# where the site and the API share one address. Default: *
ALLOW_ORIGINS=


# ─────────────────────────────────────────────────────────────────────────────
#  IMPORTING
# ─────────────────────────────────────────────────────────────────────────────

# 1: an imported ruling is published straight away.
# 0: it waits for an admin to publish it. Default: 1
AUTO_PUBLISH=1


# ─────────────────────────────────────────────────────────────────────────────
#  THE MODEL STEP
#
#  Used by two things: the French translation button, and step 2 of
#  scripts/ingest.py, which writes a subject and a summary for the rulings that
#  print none. Neither is required — ingest.py --no-model skips it and then nothing
#  leaves the machine.
# ─────────────────────────────────────────────────────────────────────────────

# Which gateway the model step uses: gemini | openrouter | opencode
# Default: gemini. Overridden per run by --provider.
LLM_PROVIDER=gemini

# Override the provider's default model. Empty means use the default:
#   gemini      → gemini-2.5-flash-lite
#   openrouter  → google/gemini-2.5-flash-lite
#   opencode    → gemini-3.5-flash-lite
# Overridden per run by --model.
LLM_MODEL=

# ── Gemini, the default. Key from aistudio.google.com
# Measured on this corpus: 16,585 rulings, 8 failures, $4.85, 35 minutes.
GEMINI_API_KEY=

# ── OpenRouter, to reach models Gemini does not serve. Key from openrouter.ai/keys
#   python ingest.py ../../results --provider openrouter --model <slug>
OPENROUTER_API_KEY=

# ── OpenCode Zen, 87 models. Key from https://opencode.ai/auth (needs credit).
#   python ingest.py ../../results --provider opencode --model gemini-3.5-flash-lite
#
# Its model ids ending in -free, space-bunny-free among them, cannot be used here.
# Tested with a valid key: they answer
#     403  OpenCode's free tier can only be used from within OpenCode
# They are reserved for the OpenCode terminal app, and a key does not change that.
# A paid id on an account with no credit answers 402, which is how you tell the two
# apart. Paid ids work normally.
OPENCODE_API_KEY=

# ── The French translation button on a ruling page.
# Falls back to GEMINI_API_KEY when empty, so one key can serve both.
TRANSLATE_API_KEY=

# The model it uses. Default: gemini-2.5-flash-lite
TRANSLATE_MODEL=

# Rulings longer than this are refused rather than translated in pieces.
# Default: 120000 characters
TRANSLATE_MAX_CHARS=


# ─────────────────────────────────────────────────────────────────────────────
#  DEPLOYMENT  (read by docker-compose, not by the Python)
# ─────────────────────────────────────────────────────────────────────────────

# The hostname Caddy gets a TLS certificate for, and the address the site is served
# at. deploy-vps.sh writes both for you.
SITE_ADDRESS=
SITE_URL=

# The database container's credentials. POSTGRES_PASSWORD has no default and the
# stack will not start without it.
POSTGRES_USER=anon
POSTGRES_PASSWORD=
POSTGRES_DB=anonymize

# Baked into the frontend at build time. Leave it EMPTY on purpose: the browser then
# calls the API at whatever address it loaded the page from. Setting it wrongly is
# what makes a deployed site show "Failed to fetch".
VITE_API_URL=
