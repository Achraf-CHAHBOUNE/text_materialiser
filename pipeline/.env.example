# Project 1 — Anonymization pipeline (CLI).
# Copy to ".env" in THIS folder. Never commit the real .env.

# --- LLM (required) ---
PROVIDER=gemini
GEMINI_API_KEY=
MODEL=gemini-2.5-flash-lite

# --- Paths (relative to this folder) ---
INPUT_DIR=input
OUTPUT_DIR=output
DB_PATH=data/cases.db

# --- Processing ---
PAGES_PER_BATCH=5
MAX_WORKERS=4
REPLACEMENT_TOKEN=XXXXXXX
# SOFFICE_PATH=            # LibreOffice binary for legacy .doc (auto-detected if empty)

# --- Cost reporting (USD per 1M tokens; Gemini 2.5 Flash-Lite) ---
INPUT_PRICE_PER_M=0.10
OUTPUT_PRICE_PER_M=0.40
# BUDGET_USD — hard ceiling; the run halts as soon as it is reached (0 = no limit).
BUDGET_USD=0

# --- Prompt caching (reduces cost by not re-billing the static instruction) ---
ENABLE_PROMPT_CACHE=1
CACHE_TTL_SECONDS=3600

# --- Verification (independent 2nd-pass re-check of the anonymized text) ---
ENABLE_VERIFY=1

LOG_LEVEL=INFO
