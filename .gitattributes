# Line endings the interpreters need, whatever the checkout platform.
*.bat text eol=crlf
*.sh  text eol=lf
# Read inside Linux containers: Docker, Caddy, Garage, compose.
Dockerfile   text eol=lf
Caddyfile    text eol=lf
*.toml       text eol=lf
*.yml        text eol=lf
.dockerignore text eol=lf
# The frontend is formatted by Prettier with LF endings: checked out as LF everywhere,
# Windows included, so the formatter and the repository always agree.
platform/frontend/** text=auto eol=lf
