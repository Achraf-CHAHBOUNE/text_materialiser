pipeline/input/*
!pipeline/input/.gitkeep
pipeline/output/*
!pipeline/output/.gitkeep
pipeline/data/
platform/backend/data/

# Databases
*.db

# Raw corpora / archives — real PII, never commit
*.rar
*.7z
01_civile*
corpus_*/
