# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node / frontend build
node_modules/
platform/frontend/.output/
platform/frontend/dist/
platform/frontend/.nitro/
platform/frontend/.tanstack/
.vite/

# Archives
*.zip

# Secrets & runtime
.env
**/.env
**/.anonymizer_state.json

# Pipeline local I/O — raw PII documents must NEVER be committed.
# Keep the empty folder placeholders only.
pipeline/input/*
!pipeline/input/.gitkeep
pipeline/output/*
!pipeline/output/.gitkeep
pipeline/data/
platform/backend/data/

# Databases
*.db

# Raw corpora / archives — real PII, never commit
*.rar
*.7z
01_civile*
corpus_*/

# Google Cloud service-account keys — never commit
*.gcp-key.json
gcp-key.json
service-account*.json
*-sa-key.json

# Raw corpus folders delivered by the client (NN_name) — real PII, never commit
[0-9][0-9]_*/

# Pipeline output folders kept at the repo root for review
out_statut*/
test_statut_input/
