# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node / frontend build
node_modules/
platform/frontend/.output/
platform/frontend/dist/
platform/frontend/.nitro/
platform/frontend/.tanstack/
.vite/

# Archives
*.zip

# Secrets & runtime
.env
**/.env
**/.anonymizer_state.json

# Pipeline local I/O — raw PII documents must NEVER be committed.
# Keep the empty folder placeholders only.
pipeline/input/*
!pipeline/input/.gitkeep
pipeline/output/*
!pipeline/output/.gitkeep
pipeline/data/
platform/backend/data/

# Databases
*.db

# Raw corpora / archives — real PII, never commit
*.rar
*.7z
01_civile*
corpus_*/

# Google Cloud service-account keys — never commit
*.gcp-key.json
gcp-key.json
service-account*.json
*-sa-key.json

# Raw corpus folders delivered by the client (NN_name) — real PII, never commit
[0-9][0-9]_*/

# Pipeline output folders kept at the repo root for review
out_statut*/
test_statut_input/
output_first/

# Safety copies of delivered output taken before maintenance passes — real data
backup_*/

# ALL real data lives here: raw client folders, working state, old handoffs.
data/
# The generated client hand-off (anonymized, but still the client's data).
results/

# Demo pack: real (anonymized) rulings, built on demand from results/
platform/demo-pack/
platform/demo-pack.zip
platform/demo-logins.txt

# Raw deliveries from the client: the original, non-anonymized PDFs. 14 GB of real
# names. Nothing under here ever belongs in version control.
lastinput/
input/
*.rar

# Scratch space the deploy and migration scripts hand to the containers. It has held
# an export of every ruling's text, so it is ignored wholesale rather than per file.
platform/incoming/

# Screenshots taken while checking the deployed site.
vps-*.png

# The delivery: every ruling's full text, in Arabic and French. Never committed.
delivery/
delivery-*/

# Backups: database dumps, every Word file, and a copy of .env -- never in git
platform/backups/
backups/
